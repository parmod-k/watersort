# Copy to .env and adjust. Defaults match a stock XAMPP install (root, no password).
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=watersort
# Comma-separated origins allowed to call the API from a browser (the Expo web dev server).
CORS_ORIGINS=http://localhost:8081,http://localhost:8123
# Sign in with Google: the OAuth *web* client ID the app passes to GoogleSignin.configure (comma-separated if several).
GOOGLE_CLIENT_IDS=
# Sign in with Apple: the iOS bundle identifier (app.json ios.bundleIdentifier).
APPLE_BUNDLE_IDS=com.watersortapp
