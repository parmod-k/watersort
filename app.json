{
  "expo": {
    "name": "WaterSortApp",
    "slug": "WaterSortApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "watersort",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2B170C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.watersortapp"
    },
    "android": {
      "package": "com.watersortapp",
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#2B170C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5371388954072964~8691216029",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      "./plugins/withGoogleMobileAdsBackend",
      [
        "expo-iap",
        {
          "android": {
            "store": "play"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "846a81f5-1efe-44d1-acab-ba7445a79c0d"
      }
    },
    "owner": "kiratitechsolutions-parmod"
  }
}
